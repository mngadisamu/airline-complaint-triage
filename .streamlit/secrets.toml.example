# Copy this file to .streamlit/secrets.toml (it is git-ignored) and fill in the lines you need.
# On Streamlit Community Cloud, paste the same lines into the app's Secrets box instead.

# 1. AI drafts (needed for the "Draft with AI" switch)
GEMINI_API_KEY = "paste-your-key-here"
# If the model name stops working, set a current one from Google AI Studio.
# GEMINI_MODEL = "gemini-3.5-flash-lite"

# 2. Platform admin (set BEFORE the first run on a live link; the demo password is published in the README)
# PLATFORM_ADMIN_USERNAME = "your.username"
# PLATFORM_ADMIN_PASSWORD = "a long password only you know"

# 3. Emailing sign-in details to new people (optional; without it the admin is shown the details once)
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "your.address@gmail.com"
# SMTP_PASSWORD = "a Google app password, not your normal password"
# SMTP_FROM = "Tower <your.address@gmail.com>"
# APP_URL = "https://your-app.streamlit.app"
